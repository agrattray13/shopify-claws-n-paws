<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }} | {{ shop.name }}</title>
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Lato:wght@400;600;700&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body class="template-customers-{{ template | replace: 'customers/', '' | handle }}">

  <header class="site-header">
    <div class="site-header__inner">
      <div class="site-header__logo">
        <a href="{{ routes.root_url }}">
          <span class="logo-text">Paws <span>&</span> Claws</span>
        </a>
      </div>
    </div>
  </header>

  <main id="main-content" role="main" class="container" style="padding-top: var(--spacing-lg); padding-bottom: var(--spacing-lg);">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
