<div style="max-width: 480px; margin: 0 auto;">
  <h1 style="text-align:center; margin-bottom: var(--spacing-md);">Create Account</h1>

  {% form 'create_customer' %}
    {%- if form.errors -%}
      <div style="background:#fee2e2; color:#b91c1c; padding:1rem 1.25rem; border-radius:var(--radius-sm); margin-bottom:1.25rem;">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1.25rem;">
      <div class="form-group" style="margin-bottom:0;">
        <label for="FirstName">First Name</label>
        <input class="form-control" type="text" id="FirstName" name="customer[first_name]" autocomplete="given-name">
      </div>
      <div class="form-group" style="margin-bottom:0;">
        <label for="LastName">Last Name</label>
        <input class="form-control" type="text" id="LastName" name="customer[last_name]" autocomplete="family-name">
      </div>
    </div>

    <div class="form-group">
      <label for="Email">Email</label>
      <input class="form-control" type="email" id="Email" name="customer[email]" autocomplete="email" required>
    </div>

    <div class="form-group">
      <label for="Password">Password</label>
      <input class="form-control" type="password" id="Password" name="customer[password]" autocomplete="new-password" required>
      <p style="font-size:0.8rem; color:#888; margin-top:0.3rem;">Must be at least 5 characters.</p>
    </div>

    <button type="submit" class="btn btn-primary btn-full btn-lg">Create Account</button>
  {% endform %}

  <p style="text-align:center; margin-top:1.5rem; font-size:0.9rem;">
    Already have an account? <a href="{{ routes.account_login_url }}" style="color:var(--color-accent); font-weight:600;">Sign in</a>
  </p>
</div>
