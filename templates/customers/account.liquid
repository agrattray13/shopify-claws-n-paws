<div style="max-width: 800px; margin: 0 auto;">
  <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem; margin-bottom: var(--spacing-md);">
    <h1>My Account</h1>
    <a href="{{ routes.account_logout_url }}" class="btn btn-outline btn-sm">Sign Out</a>
  </div>

  <p style="margin-bottom: var(--spacing-md);">Welcome back, {{ customer.first_name }}!</p>

  <!-- Order history -->
  <h2 style="margin-bottom:1rem;">Order History</h2>

  {%- if customer.orders.size > 0 -%}
    <div style="overflow-x:auto;">
      <table style="width:100%; border-collapse:collapse; font-size:0.9rem;">
        <thead>
          <tr style="border-bottom:2px solid var(--color-border);">
            <th style="padding:0.75rem; text-align:left; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--color-primary);">Order</th>
            <th style="padding:0.75rem; text-align:left; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--color-primary);">Date</th>
            <th style="padding:0.75rem; text-align:left; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--color-primary);">Status</th>
            <th style="padding:0.75rem; text-align:right; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--color-primary);">Total</th>
          </tr>
        </thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr style="border-bottom:1px solid var(--color-border);">
              <td style="padding:0.875rem 0.75rem;">
                <a href="{{ order.customer_url }}" style="font-weight:600; color:var(--color-accent);">{{ order.name }}</a>
              </td>
              <td style="padding:0.875rem 0.75rem; color:#666;">{{ order.created_at | date: '%b %d, %Y' }}</td>
              <td style="padding:0.875rem 0.75rem;">
                <span class="badge{% if order.financial_status == 'paid' %} badge--new{% endif %}">{{ order.financial_status_label }}</span>
              </td>
              <td style="padding:0.875rem 0.75rem; text-align:right; font-weight:700;">{{ order.total_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  {%- else -%}
    <div style="text-align:center; padding: var(--spacing-md); background:var(--color-white); border-radius:var(--radius-md); box-shadow:var(--shadow-sm);">
      <p style="opacity:0.7; margin-bottom:1rem;">You haven't placed any orders yet.</p>
      <a href="{{ routes.collections_url }}/all" class="btn btn-primary">Start Shopping</a>
    </div>
  {%- endif -%}

  <!-- Account details -->
  <div style="margin-top: var(--spacing-lg); background:var(--color-white); border-radius:var(--radius-md); padding: var(--spacing-md); box-shadow:var(--shadow-sm);">
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem;">
      <h2 style="font-size:1.1rem;">Account Details</h2>
      <a href="{{ routes.account_addresses_url }}" class="btn btn-outline btn-sm">Manage Addresses</a>
    </div>
    <p><strong>{{ customer.name }}</strong></p>
    <p>{{ customer.email }}</p>
    {%- if customer.default_address -%}
      <div style="margin-top:0.75rem; font-size:0.9rem; line-height:1.7; color:#666;">
        {{ customer.default_address | format_address }}
      </div>
    {%- endif -%}
  </div>
</div>
