{%- comment -%}
  Render a product card.
  Usage: render 'product-card', product: product
{%- endcomment -%}

{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price -%}
  {%- assign on_sale = true -%}
{%- endif -%}

<article class="product-card" aria-label="{{ product.title | escape }}">
  <a href="{{ product.url }}" class="product-card__image-wrap" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image -%}
      <img
        src="{{ product.featured_image | image_url: width: 500 }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        width="500"
        height="500"
        loading="lazy">
    {%- else -%}
      <div style="width:100%;height:100%;background-color:#f0ece3;display:flex;align-items:center;justify-content:center;font-size:3rem;">🐾</div>
    {%- endif -%}

    {%- if on_sale -%}
      <span class="product-card__badge product-card__badge--sale">Sale</span>
    {%- elsif product.tags contains 'new' or product.tags contains 'New' -%}
      <span class="product-card__badge product-card__badge--new">New</span>
    {%- endif -%}
  </a>

  <div class="product-card__body">
    {%- if product.vendor != blank -%}
      <p class="product-card__vendor">{{ product.vendor }}</p>
    {%- endif -%}

    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    <div class="product-card__price">
      {%- if on_sale -%}
        <span class="price price--sale">{{ product.price | money }}</span>
        <span class="price price--compare">{{ product.compare_at_price | money }}</span>
      {%- else -%}
        <span class="price">
          {%- if product.price_varies -%}From {% endif -%}
          {{ product.price | money }}
        </span>
      {%- endif -%}
    </div>

    {%- unless product.available -%}
      <p style="font-size:0.8rem; color:#999; margin-top:0.25rem;">Sold out</p>
    {%- endunless -%}
  </div>
</article>
