<section class="section bg-green"><div class="page-width text-center">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.text }}</p>
  {%- form 'customer', class: 'newsletter-form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    {%- if form.posted_successfully? -%}
      <div class="notice" role="status" style="flex:1 1 100%">{{ 'newsletter.success' | t }}</div>
    {%- else -%}
      <label class="visually-hidden" for="NL-{{ section.id }}">{{ 'newsletter.email' | t }}</label>
      <input type="email" id="NL-{{ section.id }}" name="contact[email]" required placeholder="{{ 'newsletter.email' | t }}" autocomplete="email">
      <button type="submit" class="btn">{{ 'newsletter.subscribe' | t }}</button>
    {%- endif -%}
  {%- endform -%}
</div></section>
{% schema %}
{ "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the pack" },
    { "type": "text", "id": "text", "label": "Text", "default": "Get 10% off your first order and pet-care tips." }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
