<section class="section"><div class="page-width" style="max-width:28rem">
  <h1>{{ 'customer.login' | t }}</h1>
  {%- form 'customer_login' -%}
    {%- if form.errors -%}<div class="error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="CL-email">{{ 'customer.email' | t }}</label><input id="CL-email" type="email" name="customer[email]" autocomplete="email" required></div>
    <div class="field"><label for="CL-pw">{{ 'customer.password' | t }}</label><input id="CL-pw" type="password" name="customer[password]" autocomplete="current-password" required></div>
    <button class="btn" type="submit">{{ 'customer.login' | t }}</button>
  {%- endform -%}
  <p><a href="{{ routes.account_register_url }}">{{ 'customer.register' | t }}</a></p>
</div></section>
{% schema %}{ "name": "Login" }{% endschema %}
