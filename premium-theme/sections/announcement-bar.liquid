{%- if section.settings.message != blank -%}
<div class="announcement" role="region" aria-label="Announcement">
  {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{{ section.settings.message }}</a>{%- else -%}{{ section.settings.message }}{%- endif -%}
</div>
{%- endif -%}
{% schema %}
{ "name": "Announcement bar", "settings": [
  { "type": "text", "id": "message", "label": "Message", "default": "Free shipping on orders over $50" },
  { "type": "url", "id": "link", "label": "Link" }
] }
{% endschema %}
