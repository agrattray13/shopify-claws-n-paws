<section class="hero" data-hero data-seconds="{{ section.settings.seconds }}" data-fade="{{ section.settings.fade }}" style="--hero-h: {{ section.settings.height }}vh" aria-roledescription="carousel" aria-label="{{ section.settings.heading | default: 'Hero' | escape }}">
  {%- for block in section.blocks -%}
    <div class="hero__slide" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', loading: forloop.first | ternary: 'eager', 'lazy', fetchpriority: forloop.first | ternary: 'high', 'auto', alt: block.settings.image.alt | default: block.settings.heading }}
      {%- else -%}<div class="hero__placeholder">{{ 'hero-apparel-1' | placeholder_svg_tag }}</div>{%- endif -%}
      <div class="hero__content">
        {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading }}</h2>{%- endif -%}
        {%- if block.settings.subheading != blank -%}<p>{{ block.settings.subheading }}</p>{%- endif -%}
        {%- if block.settings.button_label != blank -%}<a class="btn" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label }}</a>{%- endif -%}
      </div>
    </div>
  {%- endfor -%}
  {%- if section.blocks.size > 1 -%}
    <div class="hero__dots">
      {%- for block in section.blocks -%}<button type="button" class="hero__dot" aria-label="Slide {{ forloop.index }}" aria-current="false"></button>{%- endfor -%}
    </div>
  {%- endif -%}
</section>
{% schema %}
{ "name": "Hero slideshow",
  "settings": [
    { "type": "range", "id": "seconds", "label": "Seconds per slide", "min": 3, "max": 15, "step": 1, "default": 6 },
    { "type": "range", "id": "fade", "label": "Fade length (seconds)", "min": 0.5, "max": 5, "step": 0.5, "default": 2 },
    { "type": "range", "id": "height", "label": "Height (% of viewport)", "min": 40, "max": 100, "step": 5, "default": 80 }
  ],
  "blocks": [ { "type": "slide", "name": "Slide", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Premium care for every paw" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Thoughtfully chosen essentials for dogs and cats" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ] } ],
  "min_blocks": 1, "max_blocks": 5,
  "presets": [ { "name": "Hero slideshow", "blocks": [ { "type": "slide" }, { "type": "slide" }, { "type": "slide" } ] } ]
}
{% endschema %}
