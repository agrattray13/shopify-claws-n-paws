<div class="page-banner{% if section.settings.image != blank %} page-banner--image{% endif %}">
  {%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 2000 | image_tag: widths: '800, 1200, 1600, 2000', sizes: '100vw', loading: 'eager', alt: '' }}{%- endif -%}
  <div class="page-width">
    <h1>{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
  </div>
</div>
{% schema %}
{ "name": "Page banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "text", "label": "Text" }
  ],
  "presets": [ { "name": "Page banner" } ]
}
{% endschema %}
