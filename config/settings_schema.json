[
  {
    "name": "theme_info",
    "theme_name": "Paws & Claws",
    "theme_version": "1.0.0",
    "theme_author": "Paws & Claws",
    "theme_documentation_url": "https://pawsandclaws.com",
    "theme_support_url": "https://pawsandclaws.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary color",
        "default": "#162238"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent color",
        "default": "#D4A65A"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background color",
        "default": "#F7F3EA"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary color",
        "default": "#7E9B81"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text color",
        "default": "#252525"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "playfair_display_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "lato_n4"
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_max_width",
        "min": 80,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo max width",
        "default": 160
      }
    ]
  },
  {
    "name": "Announcement Bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_announcement",
        "label": "Show announcement bar",
        "default": true
      },
      {
        "type": "text",
        "id": "announcement_text",
        "label": "Announcement text",
        "default": "Free Shipping on Qualifying Orders | Because Every Pet Deserves Something Special"
      },
      {
        "type": "url",
        "id": "announcement_link",
        "label": "Announcement link"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image"
      }
    ]
  }
]
