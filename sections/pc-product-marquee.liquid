{{ 'pc-product-cards.css' | asset_url | stylesheet_tag }}
{% assign rail_collection = section.settings.collection %}

<section class="pc-product-rail" data-pc-product-rail>
  <div class="pc-product-rail__top">
    <div>
      {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    {% if rail_collection != blank %}
      <a href="{{ rail_collection.url }}">View collection <span>→</span></a>
    {% endif %}
  </div>

  {% if rail_collection != blank and rail_collection.products_count > 0 %}
    <div class="pc-product-rail__viewport">
      <div class="pc-product-rail__track" data-pc-rail-track>
        {% for pass in (1..2) %}
          <div class="pc-product-rail__set"{% if pass == 2 %} aria-hidden="true"{% endif %}>
            {% for product in rail_collection.products limit: section.settings.products_to_show %}
              <div class="pc-product-rail__card">
                {% render 'pc-product-card', product: product %}
              </div>
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
    <button class="pc-product-rail__pause" type="button" aria-pressed="false" data-pc-rail-pause>Pause motion</button>
  {% else %}
    <div class="pc-product-rail__empty">Choose a collection to start the moving showcase.</div>
  {% endif %}
</section>

{% stylesheet %}
  .pc-product-rail { overflow: hidden; padding: 92px 0 88px; background: #162238; color: #fff; }
  .pc-product-rail__top { max-width: 1480px; margin: 0 auto 38px; padding: 0 24px; display: flex; align-items: end; justify-content: space-between; gap: 24px; }
  .pc-product-rail__top p { margin: 0 0 12px; color: #d4a65a; font-size: 10px; font-weight: 850; letter-spacing: .15em; text-transform: uppercase; }
  .pc-product-rail__top h2 { margin: 0; font-size: clamp(38px,5vw,66px); line-height: .98; letter-spacing: -.05em; }
  .pc-product-rail__top > a { margin-bottom: 5px; display: inline-flex; align-items: center; gap: 9px; color: #fff; text-decoration: none; font-size: 10px; font-weight: 820; letter-spacing: .08em; text-transform: uppercase; }
  .pc-product-rail__top > a span { transition: transform .2s ease; }
  .pc-product-rail__top > a:hover span { transform: translateX(4px); }
  .pc-product-rail__viewport { overflow: hidden; padding: 8px 0 18px; }
  .pc-product-rail__track { width: max-content; display: flex; animation: pcProductRail 48s linear infinite; }
  .pc-product-rail__set { display: flex; gap: 15px; padding-right: 15px; }
  .pc-product-rail__card { width: clamp(245px, 20vw, 320px); flex: 0 0 auto; }
  .pc-product-rail:hover .pc-product-rail__track,
  .pc-product-rail.is-paused .pc-product-rail__track { animation-play-state: paused; }
  .pc-product-rail__pause { margin: 17px auto 0; padding: 9px 14px; border: 1px solid rgba(255,255,255,.25); border-radius: 999px; background: transparent; color: rgba(255,255,255,.75); display: block; cursor: pointer; font-size: 9px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .pc-product-rail__pause:hover { border-color: #d4a65a; color: #d4a65a; }
  .pc-product-rail__empty { max-width: 1480px; min-height: 180px; margin: auto; display: grid; place-items: center; color: rgba(255,255,255,.65); }
  @keyframes pcProductRail { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (max-width: 749px) {
    .pc-product-rail { padding: 70px 0 65px; }
    .pc-product-rail__top { display: block; padding-inline: 18px; }
    .pc-product-rail__top > a { margin-top: 20px; }
    .pc-product-rail__card { width: 235px; }
    .pc-product-rail__track { animation-duration: 38s; }
  }
  @media (prefers-reduced-motion: reduce) { .pc-product-rail__track { animation: none; } .pc-product-rail__pause { display: none; } }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-pc-product-rail]').forEach((rail) => {
    if (rail.dataset.pcReady === 'true') return;
    rail.dataset.pcReady = 'true';
    const pause = rail.querySelector('[data-pc-rail-pause]');
    if (!pause) return;
    pause.addEventListener('click', () => {
      const paused = rail.classList.toggle('is-paused');
      pause.setAttribute('aria-pressed', paused ? 'true' : 'false');
      pause.textContent = paused ? 'Resume motion' : 'Pause motion';
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "P&C moving products",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Always something new" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something Special for Every Paw" },
    { "type": "range", "id": "products_to_show", "label": "Products in loop", "min": 4, "max": 10, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "P&C moving products" }]
}
{% endschema %}
