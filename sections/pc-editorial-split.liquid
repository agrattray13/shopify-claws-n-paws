{% assign editorial_collection = section.settings.collection %}
<section class="pc-editorial pc-editorial--{{ section.settings.layout }} pc-editorial--{{ section.settings.background_style }}">
  <div class="pc-editorial__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600,900,1200,1500,1800', sizes: '(min-width: 750px) 55vw, 100vw', alt: section.settings.heading }}
    {% elsif editorial_collection != blank and editorial_collection.featured_image != blank %}
      {{ editorial_collection.featured_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600,900,1200,1500,1800', sizes: '(min-width: 750px) 55vw, 100vw', alt: editorial_collection.title }}
    {% else %}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'pc-editorial__placeholder' }}
    {% endif %}
  </div>

  <div class="pc-editorial__content">
    <div class="pc-editorial__copy">
      {% if section.settings.eyebrow != blank %}<p class="pc-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}<div class="pc-editorial__text">{{ section.settings.text }}</div>{% endif %}
      {% if editorial_collection != blank and section.settings.link_label != blank %}
        <a class="pc-editorial__button" href="{{ editorial_collection.url }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">→</span></a>
      {% elsif section.settings.custom_link != blank and section.settings.link_label != blank %}
        <a class="pc-editorial__button" href="{{ section.settings.custom_link }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">→</span></a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .pc-editorial { min-height: 660px; display: grid; grid-template-columns: 1.08fr .92fr; background: #f7f3ea; color: #162238; }
  .pc-editorial--image-right { grid-template-columns: .92fr 1.08fr; }
  .pc-editorial--image-right .pc-editorial__media { order: 2; }
  .pc-editorial--image-right .pc-editorial__content { order: 1; }
  .pc-editorial--navy { background: #162238; color: #fff; }
  .pc-editorial--sage { background: #dfe8df; color: #162238; }
  .pc-editorial__media { min-height: 660px; overflow: hidden; background: #eae8e1; }
  .pc-editorial__media img,
  .pc-editorial__placeholder { width: 100%; height: 100%; display: block; object-fit: cover; }
  .pc-editorial__content { padding: 70px clamp(34px, 6vw, 104px); display: flex; align-items: center; }
  .pc-editorial__copy { max-width: 570px; }
  .pc-editorial__eyebrow { margin: 0 0 14px; color: #7e9b81; font-size: 10px; font-weight: 850; letter-spacing: .15em; text-transform: uppercase; }
  .pc-editorial--navy .pc-editorial__eyebrow { color: #d4a65a; }
  .pc-editorial h2 { margin: 0; font-size: clamp(44px,5vw,72px); line-height: .96; letter-spacing: -.055em; text-wrap: balance; }
  .pc-editorial__text { margin-top: 21px; color: color-mix(in srgb, currentColor 72%, transparent); font-size: 14px; line-height: 1.75; }
  .pc-editorial__text p { margin: 0; }
  .pc-editorial__button { margin-top: 28px; min-height: 49px; padding: 13px 20px; border-radius: 999px; background: currentColor; display: inline-flex; align-items: center; gap: 13px; text-decoration: none; font-size: 10px; font-weight: 850; letter-spacing: .07em; text-transform: uppercase; }
  .pc-editorial--cream .pc-editorial__button,
  .pc-editorial--sage .pc-editorial__button { color: #fff; background: #162238; }
  .pc-editorial--navy .pc-editorial__button { color: #162238; background: #f7f3ea; }
  .pc-editorial__button span { transition: transform .2s ease; }
  .pc-editorial__button:hover span { transform: translateX(5px); }
  @media (max-width: 749px) {
    .pc-editorial,
    .pc-editorial--image-right { min-height: 0; grid-template-columns: 1fr; }
    .pc-editorial--image-right .pc-editorial__media,
    .pc-editorial--image-right .pc-editorial__content { order: initial; }
    .pc-editorial__media { min-height: 430px; }
    .pc-editorial__content { padding: 60px 22px 66px; }
    .pc-editorial h2 { font-size: clamp(42px,13vw,62px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "P&C editorial split",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "collection", "id": "collection", "label": "Linked collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made for real pet life" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Big Adventures Start With Happy Pets." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>From everyday routines to weekend adventures, discover products chosen for comfort, play, and more time together.</p>" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Explore the collection" },
    { "type": "url", "id": "custom_link", "label": "Custom link", "info": "Used only when no collection is selected." },
    { "type": "select", "id": "layout", "label": "Image position", "default": "image-left", "options": [
      { "value": "image-left", "label": "Left" }, { "value": "image-right", "label": "Right" }
    ] },
    { "type": "select", "id": "background_style", "label": "Background", "default": "cream", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "navy", "label": "Navy" }, { "value": "sage", "label": "Sage" }
    ] }
  ],
  "presets": [{ "name": "P&C editorial split" }]
}
{% endschema %}
