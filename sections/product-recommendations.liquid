<div class="product-recommendations" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4">
{%- if recommendations.performed and recommendations.products_count > 0 -%}
<section class="section bg-tan"><div class="page-width">
  <h2 class="section-heading">{{ section.settings.heading }}</h2>
  <div class="grid">{%- for p in recommendations.products limit: 4 -%}{% render 'product-card', product: p %}{%- endfor -%}</div>
</div></section>
{%- endif -%}
</div>
<script>
  (function () {
    var el = document.currentScript.previousElementSibling;
    if (!el || el.querySelector('.grid')) return;
    fetch(el.dataset.url).then(function (r) { return r.text(); }).then(function (t) {
      var d = new DOMParser().parseFromString(t, 'text/html').querySelector('.product-recommendations');
      if (d && d.querySelector('.grid')) { el.innerHTML = d.innerHTML; el.querySelectorAll('.reveal').forEach(function (n) { n.classList.add('is-visible'); }); }
    });
  })();
</script>
{% schema %}
{ "name": "Product recommendations",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "You May Also Like" } ] }
{% endschema %}
