<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="site-footer__grid">

      <!-- Brand column -->
      <div class="site-footer__brand">
        <div class="site-footer__logo">Paws <span>&</span> Claws</div>
        <p>Premium pet supplies for dogs and cats. Because every pet deserves something special.</p>

        <!-- Social links -->
        <div class="footer-social" aria-label="Social media">
          <a href="#" aria-label="Facebook" rel="noopener noreferrer" target="_blank">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
          <a href="#" aria-label="Instagram" rel="noopener noreferrer" target="_blank">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37zm1.5-4.87h.01M6.5 19.5h11A2.5 2.5 0 0 0 20 17V7a2.5 2.5 0 0 0-2.5-2.5h-11A2.5 2.5 0 0 0 4 7v10a2.5 2.5 0 0 0 2.5 2.5z"/>
            </svg>
          </a>
          <a href="#" aria-label="TikTok" rel="noopener noreferrer" target="_blank">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>
            </svg>
          </a>
          <a href="#" aria-label="Pinterest" rel="noopener noreferrer" target="_blank">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 2C6.477 2 2 6.477 2 12c0 4.236 2.636 7.855 6.356 9.312-.088-.791-.167-2.005.035-2.868.181-.78 1.172-4.97 1.172-4.97s-.299-.598-.299-1.482c0-1.388.806-2.428 1.808-2.428.852 0 1.265.64 1.265 1.408 0 .858-.546 2.141-.828 3.33-.236.995.499 1.806 1.476 1.806 1.771 0 3.133-1.867 3.133-4.563 0-2.387-1.715-4.056-4.163-4.056-2.836 0-4.5 2.127-4.5 4.327 0 .856.33 1.774.741 2.276a.3.3 0 0 1 .069.286c-.075.313-.243.995-.276 1.134-.044.183-.146.222-.337.134-1.249-.581-2.03-2.407-2.03-3.874 0-3.154 2.292-6.052 6.608-6.052 3.469 0 6.165 2.473 6.165 5.776 0 3.447-2.173 6.22-5.19 6.22-1.013 0-1.966-.527-2.292-1.148l-.623 2.378c-.226.869-.835 1.958-1.244 2.621.937.29 1.931.446 2.962.446 5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Shop -->
      <div class="footer-col">
        <p class="footer-col__title">Shop</p>
        <ul class="footer-col__links">
          <li><a href="{{ routes.collections_url }}/dogs">Dogs</a></li>
          <li><a href="{{ routes.collections_url }}/cats">Cats</a></li>
          <li><a href="{{ routes.collections_url }}/new-arrivals">New Arrivals</a></li>
          <li><a href="{{ routes.collections_url }}/best-sellers">Best Sellers</a></li>
          <li><a href="{{ routes.collections_url }}/all">Shop All</a></li>
        </ul>
      </div>

      <!-- Customer Care -->
      <div class="footer-col">
        <p class="footer-col__title">Customer Care</p>
        <ul class="footer-col__links">
          <li><a href="{{ routes.root_url }}pages/faq">FAQ</a></li>
          <li><a href="{{ routes.root_url }}pages/contact">Contact Us</a></li>
          <li><a href="{{ routes.root_url }}policies/shipping-policy">Shipping Policy</a></li>
          <li><a href="{{ routes.root_url }}policies/refund-policy">Returns & Refunds</a></li>
          <li><a href="{{ routes.account_url }}">My Account</a></li>
        </ul>
      </div>

      <!-- Information -->
      <div class="footer-col">
        <p class="footer-col__title">Information</p>
        <ul class="footer-col__links">
          <li><a href="{{ routes.root_url }}pages/about">About Us</a></li>
          <li><a href="{{ routes.root_url }}blogs/news">Blog</a></li>
          <li><a href="{{ routes.root_url }}policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="{{ routes.root_url }}policies/terms-of-service">Terms of Service</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="footer-col">
        <p class="footer-col__title">Contact</p>
        <ul class="footer-col__links" style="line-height: 1.8;">
          <li>{{ shop.email }}</li>
          {%- if shop.phone -%}
            <li>{{ shop.phone }}</li>
          {%- endif -%}
          {%- if shop.address -%}
            <li>{{ shop.address.city }}, {{ shop.address.country }}</li>
          {%- endif -%}
        </ul>
      </div>

    </div><!-- /.site-footer__grid -->

    <div class="site-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      <span>Made with ♥ for pets</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
