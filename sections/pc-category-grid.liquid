<section class="pc-category-section">
  <div class="pc-category-section__top">
    <div class="pc-section-heading">
      {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}<div>{{ section.settings.text }}</div>{% endif %}
    </div>
    {% if section.settings.all_link != blank and section.settings.all_label != blank %}
      <a class="pc-text-link" href="{{ section.settings.all_link }}">{{ section.settings.all_label | escape }} <span>→</span></a>
    {% endif %}
  </div>

  <div class="pc-category-grid">
    {% for block in section.blocks %}
      {% assign category_collection = block.settings.collection %}
      {% if category_collection != blank %}
        <a class="pc-category-card" href="{{ category_collection.url }}" {{ block.shopify_attributes }}>
          <div class="pc-category-card__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,650,900', sizes: '(min-width: 1200px) 20vw, (min-width: 750px) 33vw, 48vw', alt: block.settings.title }}
            {% elsif category_collection.featured_image != blank %}
              {{ category_collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,650,900', sizes: '(min-width: 1200px) 20vw, (min-width: 750px) 33vw, 48vw', alt: category_collection.title }}
            {% else %}
              {{ 'collection-2' | placeholder_svg_tag: 'pc-category-card__placeholder' }}
            {% endif %}
          </div>
          <div class="pc-category-card__content">
            <span>{{ block.settings.title | default: category_collection.title | escape }}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .pc-category-section { padding: 96px max(24px, calc((100vw - 1480px)/2)); background: #fff; color: #162238; }
  .pc-category-section__top { display: flex; align-items: end; justify-content: space-between; gap: 30px; }
  .pc-text-link { margin-bottom: 42px; display: inline-flex; gap: 10px; align-items: center; color: #162238; text-decoration: none; font-size: 10px; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
  .pc-text-link span { transition: transform .2s ease; }
  .pc-text-link:hover span { transform: translateX(4px); }
  .pc-category-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 14px; }
  .pc-category-card { min-width: 0; overflow: hidden; border: 1px solid #ecebe6; border-radius: 21px; background: #f8f7f2; color: #162238; text-decoration: none; transition: transform .22s ease, box-shadow .22s ease; }
  .pc-category-card:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(22,34,56,.09); }
  .pc-category-card__media { aspect-ratio: 1.05/1; overflow: hidden; background: #f1efe8; }
  .pc-category-card__media img,
  .pc-category-card__placeholder { width: 100%; height: 100%; display: block; object-fit: cover; transition: transform .35s ease; }
  .pc-category-card:hover img { transform: scale(1.035); }
  .pc-category-card__content { min-height: 67px; padding: 15px 17px; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .pc-category-card__content span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; font-weight: 820; }
  .pc-category-card__content svg { width: 19px; flex: 0 0 auto; color: #7e9b81; }
  @media (max-width: 989px) { .pc-category-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 749px) {
    .pc-category-section { padding: 70px 18px; }
    .pc-category-section__top { display: block; }
    .pc-text-link { margin: -18px 0 29px; }
    .pc-category-grid { gap: 9px; }
    .pc-category-card { border-radius: 16px; }
    .pc-category-card__content { min-height: 56px; padding: 12px; }
    .pc-category-card__content span { font-size: 11px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "P&C category grid",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Everyday essentials" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find Their Favorites" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>From playtime to bedtime, browse the categories that make pet life better.</p>" },
    { "type": "text", "id": "all_label", "label": "Top link label", "default": "Shop all" },
    { "type": "url", "id": "all_link", "label": "Top link" }
  ],
  "blocks": [
    { "type": "category", "name": "Category", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "image_picker", "id": "image", "label": "Override image" },
      { "type": "text", "id": "title", "label": "Display title" }
    ] }
  ],
  "presets": [{ "name": "P&C category grid", "blocks": [{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}] }]
}
{% endschema %}
