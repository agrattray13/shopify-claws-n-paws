<section class="pc-hero" style="--pc-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --pc-hero-min: {{ section.settings.desktop_height }}px;">
  <div class="pc-hero__media" aria-hidden="true">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750,1100,1500,2000,2400',
          sizes: '100vw',
          alt: section.settings.image.alt
      }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'pc-hero__placeholder' }}
    {% endif %}
  </div>
  <div class="pc-hero__shade"></div>

  <div class="pc-hero__content pc-hero__content--{{ section.settings.content_position }}">
    <div class="pc-hero__copy">
      {% if section.settings.eyebrow != blank %}<p class="pc-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h1>{{ section.settings.heading | escape }}</h1>{% endif %}
      {% if section.settings.text != blank %}<div class="pc-hero__text">{{ section.settings.text }}</div>{% endif %}

      <div class="pc-hero__actions">
        {% if section.settings.primary_link != blank and section.settings.primary_label != blank %}
          <a class="pc-button pc-button--solid" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }}</a>
        {% endif %}
        {% if section.settings.secondary_link != blank and section.settings.secondary_label != blank %}
          <a class="pc-button pc-button--ghost" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
        {% endif %}
      </div>
    </div>
  </div>

  {% if section.settings.show_scroll_hint %}
    <a class="pc-hero__scroll" href="#pc-home-content-{{ section.id }}" aria-label="Continue down the page">
      <span>Explore</span>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v13m0 0-5-5m5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  {% endif %}
</section>
<div id="pc-home-content-{{ section.id }}" class="pc-anchor-target" aria-hidden="true"></div>

{% stylesheet %}
  .pc-hero { position: relative; min-height: var(--pc-hero-min); overflow: hidden; background: #162238; color: #fff; }
  .pc-hero__media,
  .pc-hero__shade { position: absolute; inset: 0; }
  .pc-hero__media img,
  .pc-hero__placeholder { width: 100%; height: 100%; display: block; object-fit: cover; }
  .pc-hero__shade { background: linear-gradient(90deg, rgba(10,18,30,calc(var(--pc-overlay) + .16)) 0%, rgba(10,18,30,var(--pc-overlay)) 44%, rgba(10,18,30,.14) 100%); }
  .pc-hero__content { position: relative; z-index: 2; min-height: var(--pc-hero-min); max-width: 1520px; margin: 0 auto; padding: 72px 48px 84px; display: flex; align-items: center; }
  .pc-hero__content--left { justify-content: flex-start; text-align: left; }
  .pc-hero__content--center { justify-content: center; text-align: center; }
  .pc-hero__content--right { justify-content: flex-end; text-align: right; }
  .pc-hero__copy { width: min(720px, 100%); }
  .pc-hero__eyebrow { margin: 0 0 18px; color: #d4a65a; font-size: 11px; font-weight: 850; letter-spacing: .16em; text-transform: uppercase; }
  .pc-hero h1 { margin: 0; max-width: 760px; font-size: clamp(52px, 7vw, 108px); line-height: .91; letter-spacing: -.062em; text-wrap: balance; }
  .pc-hero__content--center h1 { margin-inline: auto; }
  .pc-hero__content--right h1 { margin-left: auto; }
  .pc-hero__text { max-width: 620px; margin-top: 25px; color: rgba(255,255,255,.82); font-size: clamp(15px, 1.2vw, 18px); line-height: 1.7; }
  .pc-hero__content--center .pc-hero__text { margin-inline: auto; }
  .pc-hero__content--right .pc-hero__text { margin-left: auto; }
  .pc-hero__text p { margin: 0; }
  .pc-hero__actions { margin-top: 31px; display: flex; flex-wrap: wrap; gap: 11px; }
  .pc-hero__content--center .pc-hero__actions { justify-content: center; }
  .pc-hero__content--right .pc-hero__actions { justify-content: flex-end; }
  .pc-button { min-height: 52px; padding: 14px 23px; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; font-size: 11px; font-weight: 850; letter-spacing: .06em; text-transform: uppercase; transition: transform .2s ease, background .2s ease, color .2s ease; }
  .pc-button:hover { transform: translateY(-2px); }
  .pc-button--solid { background: #f7f3ea; color: #162238; }
  .pc-button--solid:hover { background: #fff; }
  .pc-button--ghost { border: 1px solid rgba(255,255,255,.55); color: #fff; background: rgba(255,255,255,.06); backdrop-filter: blur(10px); }
  .pc-button--ghost:hover { background: rgba(255,255,255,.16); }
  .pc-hero__scroll { position: absolute; z-index: 3; right: 40px; bottom: 30px; display: inline-flex; align-items: center; gap: 9px; color: #fff; text-decoration: none; font-size: 9px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .pc-hero__scroll svg { width: 18px; }
  .pc-anchor-target { scroll-margin-top: 120px; }
  @media (max-width: 749px) {
    .pc-hero { min-height: 690px; }
    .pc-hero__shade { background: linear-gradient(0deg, rgba(10,18,30,.88) 0%, rgba(10,18,30,.46) 58%, rgba(10,18,30,.16) 100%); }
    .pc-hero__content { min-height: 690px; padding: 110px 22px 94px; align-items: flex-end; justify-content: flex-start; text-align: left; }
    .pc-hero h1 { font-size: clamp(48px, 15vw, 70px); }
    .pc-hero__text { font-size: 14px; line-height: 1.6; }
    .pc-hero__actions { justify-content: flex-start !important; }
    .pc-button { flex: 1 1 160px; }
    .pc-hero__scroll { right: 20px; bottom: 23px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "P&C hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For pets. For family." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything They Love. All in One Place." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Thoughtfully selected essentials, toys, comfort, and everyday favorites for happier dogs, cats, and the people who love them.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Shop dogs" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Shop cats" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "select", "id": "content_position", "label": "Content position", "default": "left", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }
    ] },
    { "type": "range", "id": "desktop_height", "label": "Desktop height", "min": 560, "max": 900, "step": 20, "unit": "px", "default": 760 },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay strength", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "checkbox", "id": "show_scroll_hint", "label": "Show Explore link", "default": true }
  ],
  "presets": [{ "name": "P&C hero" }]
}
{% endschema %}
