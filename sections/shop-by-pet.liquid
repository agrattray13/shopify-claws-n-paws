<section class="section-padding" aria-label="Shop by pet">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="shop-split">
      <!-- Dogs -->
      <a href="{{ routes.collections_url }}/dogs" class="shop-split__card">
        {%- if section.settings.dogs_image -%}
          <img
            src="{{ section.settings.dogs_image | image_url: width: 800 }}"
            alt="Shop Dogs"
            width="800"
            height="600"
            loading="lazy">
        {%- endif -%}
        <div class="shop-split__overlay">
          <p class="shop-split__title">Shop Dogs</p>
          <span class="shop-split__cta">Explore &rarr;</span>
        </div>
      </a>

      <!-- Cats -->
      <a href="{{ routes.collections_url }}/cats" class="shop-split__card">
        {%- if section.settings.cats_image -%}
          <img
            src="{{ section.settings.cats_image | image_url: width: 800 }}"
            alt="Shop Cats"
            width="800"
            height="600"
            loading="lazy">
        {%- endif -%}
        <div class="shop-split__overlay">
          <p class="shop-split__title">Shop Cats</p>
          <span class="shop-split__cta">Explore &rarr;</span>
        </div>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop Dogs & Cats",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Pet" },
    { "type": "image_picker", "id": "dogs_image", "label": "Dogs image" },
    { "type": "image_picker", "id": "cats_image", "label": "Cats image" }
  ],
  "presets": [{ "name": "Shop Dogs & Cats" }]
}
{% endschema %}
