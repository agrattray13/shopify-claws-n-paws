<section class="section"><div class="page-width">
  <h1 class="section-heading">{{ blog.title }}</h1>
  {%- paginate blog.articles by 9 -%}
    <div class="grid" style="--cols: 3">
      {%- for article in blog.articles -%}
        <article class="card reveal">
          {%- if article.image -%}<a href="{{ article.url }}" class="img-zoom" style="border-radius:16px;margin-bottom:1rem" tabindex="-1" aria-hidden="true">{{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: article.image.alt | default: article.title }}</a>{%- endif -%}
          <h2 class="card__title" style="font-size:1.3rem"><a href="{{ article.url }}">{{ article.title }}</a></h2>
          <p>{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
          <a href="{{ article.url }}">{{ 'blog.read_more' | t }}</a>
        </article>
      {%- endfor -%}
    </div>
    {%- render 'pagination', paginate: paginate -%}
  {%- endpaginate -%}
</div></section>
{% schema %}{ "name": "Blog" }{% endschema %}
