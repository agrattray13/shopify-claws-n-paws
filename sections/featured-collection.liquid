<section class="section{% if section.settings.background == 'tan' %} bg-tan{% endif %}"><div class="page-width">
  <div class="section-heading"><h2>{{ section.settings.heading }}</h2></div>
  {%- assign col = section.settings.collection -%}
  <div class="grid" style="--cols: {{ section.settings.columns }}">
    {%- if col != blank -%}
      {%- for product in col.products limit: section.settings.limit -%}{% render 'product-card', product: product %}{%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}<div class="card">
        <div class="card__media">{{ 'product-1' | placeholder_svg_tag }}</div><h3 class="card__title">Example product</h3><div class="card__price">$24.00</div></div>{%- endfor -%}
    {%- endif -%}
  </div>
  {%- if section.settings.button_label != blank and col != blank -%}<div class="text-center" style="margin-top:2.5rem"><a class="btn" href="{{ col.url }}">{{ section.settings.button_label }}</a></div>{%- endif -%}
</div></section>
{% schema %}
{ "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Products" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "cream", "label": "Cream" }, { "value": "tan", "label": "Tan" } ], "default": "cream" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all" }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
