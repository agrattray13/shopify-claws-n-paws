<header class="site-header" role="banner">
  <div class="site-header__inner">

    <!-- Logo -->
    <div class="site-header__logo">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
        {%- if settings.logo -%}
          <img
            src="{{ settings.logo | image_url: width: settings.logo_max_width }}"
            alt="{{ shop.name }}"
            width="{{ settings.logo_max_width }}"
            height="auto"
            loading="eager">
        {%- else -%}
          <span class="logo-text">Paws <span>&</span> Claws</span>
        {%- endif -%}
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="site-nav" aria-label="Primary navigation">
      <a class="site-nav__link" href="{{ routes.root_url }}">Home</a>
      <a class="site-nav__link" href="{{ routes.collections_url }}/dogs">Dogs</a>
      <a class="site-nav__link" href="{{ routes.collections_url }}/cats">Cats</a>
      <a class="site-nav__link" href="{{ routes.collections_url }}/new-arrivals">New Arrivals</a>
      <a class="site-nav__link" href="{{ routes.collections_url }}/best-sellers">Best Sellers</a>
      <a class="site-nav__link" href="{{ routes.collections_url }}/all">Shop All</a>
      <a class="site-nav__link" href="{{ routes.root_url }}pages/about">About</a>
      <a class="site-nav__link" href="{{ routes.root_url }}pages/contact">Contact</a>
    </nav>

    <!-- Header Actions -->
    <div class="site-header__actions">
      <!-- Search -->
      <button class="header-icon-btn search-toggle" aria-label="Search" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
        </svg>
      </button>

      <!-- Account -->
      <a class="header-icon-btn" href="{{ routes.account_url }}" aria-label="Account">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/>
        </svg>
      </a>

      <!-- Cart -->
      <button class="header-icon-btn cart-toggle" aria-label="Cart ({{ cart.item_count }} items)" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007Z"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="cart-count" aria-hidden="true">{{ cart.item_count }}</span>
        {%- endif -%}
      </button>

      <!-- Mobile menu toggle -->
      <button class="mobile-menu-toggle" aria-label="Open menu" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
        </svg>
      </button>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
