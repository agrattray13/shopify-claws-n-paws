<section class="section-padding" aria-label="{{ section.settings.heading }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem; margin-bottom:var(--spacing-md);">
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.view_all_url != blank -%}
          <a href="{{ section.settings.view_all_url }}" class="btn btn-outline btn-sm">View All</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.collection != blank -%}
      {%- assign featured_collection = collections[section.settings.collection] -%}
      {%- if featured_collection != blank -%}
        <div class="product-grid">
          {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
            {%- render 'product-card', product: product -%}
          {%- else -%}
            <p style="opacity:0.6;">No products found in this collection.</p>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      {%- assign featured = collections.all.products | limit: section.settings.products_to_show -%}
      <div class="product-grid">
        {%- for product in featured -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Products" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "url", "id": "view_all_url", "label": "View all URL" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    }
  ],
  "presets": [{ "name": "Featured Products" }]
}
{% endschema %}
