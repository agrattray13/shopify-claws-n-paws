<section class="pc-trust">
  <div class="pc-trust__intro">
    {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2>{{ section.settings.heading | escape }}</h2>
    {% if section.settings.text != blank %}<div>{{ section.settings.text }}</div>{% endif %}
  </div>

  <div class="pc-trust__grid">
    {% for block in section.blocks %}
      <article class="pc-trust-card" {{ block.shopify_attributes }}>
        <div class="pc-trust-card__icon" aria-hidden="true">
          {% case block.settings.icon %}
            {% when 'heart' %}<svg viewBox="0 0 32 32"><path d="M16 27S5 20.2 5 12.5C5 8.5 7.7 6 11.1 6c2.2 0 4 1.1 4.9 2.8C16.9 7.1 18.7 6 20.9 6 24.3 6 27 8.5 27 12.5 27 20.2 16 27 16 27Z" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
            {% when 'shield' %}<svg viewBox="0 0 32 32"><path d="M16 4 26 8v7.1C26 21.8 21.8 26.4 16 29 10.2 26.4 6 21.8 6 15.1V8l10-4Z" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m11.5 16 3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {% when 'box' %}<svg viewBox="0 0 32 32"><path d="M6 10 16 5l10 5v12L16 27 6 22V10Z" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m6 10 10 5 10-5M16 15v12" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
            {% else %}<svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="11" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M11 17.5c1.4 2 3 3 5 3s3.6-1 5-3M12 12h.1M20 12h.1" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          {% endcase %}
        </div>
        <h3>{{ block.settings.heading | escape }}</h3>
        <p>{{ block.settings.text | escape }}</p>
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .pc-trust { padding: 104px max(24px,calc((100vw - 1480px)/2)); background: #fff; color: #162238; }
  .pc-trust__intro { max-width: 760px; margin: 0 auto 44px; text-align: center; }
  .pc-trust__intro > p { margin: 0 0 12px; color: #d4a65a; font-size: 10px; font-weight: 850; letter-spacing: .15em; text-transform: uppercase; }
  .pc-trust__intro h2 { margin: 0; font-size: clamp(40px,5vw,68px); line-height: .98; letter-spacing: -.052em; }
  .pc-trust__intro > div { margin-top: 16px; color: #6e7883; font-size: 14px; line-height: 1.7; }
  .pc-trust__intro > div p { margin: 0; }
  .pc-trust__grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 14px; }
  .pc-trust-card { min-height: 275px; padding: 28px; border: 1px solid #ecebe6; border-radius: 22px; background: #f8f7f2; display: flex; flex-direction: column; }
  .pc-trust-card:nth-child(even) { background: #162238; color: #fff; border-color: #162238; }
  .pc-trust-card__icon { width: 52px; height: 52px; border-radius: 15px; display: grid; place-items: center; background: #e7eee6; color: #607b64; }
  .pc-trust-card:nth-child(even) .pc-trust-card__icon { background: rgba(212,166,90,.14); color: #d4a65a; }
  .pc-trust-card__icon svg { width: 29px; height: 29px; }
  .pc-trust-card h3 { margin: auto 0 10px; font-size: 19px; letter-spacing: -.035em; }
  .pc-trust-card p { margin: 0; color: color-mix(in srgb,currentColor 68%,transparent); font-size: 12px; line-height: 1.65; }
  @media (max-width: 989px) { .pc-trust__grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 749px) {
    .pc-trust { padding: 74px 18px; }
    .pc-trust__grid { grid-template-columns: 1fr; }
    .pc-trust-card { min-height: 220px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "P&C trust section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why shop Paws & Claws" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built Around the Pets You Love" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A straightforward pet store built around useful products, secure shopping, and a better experience for pet parents.</p>" }
  ],
  "blocks": [
    { "type": "trust", "name": "Trust point", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "heart", "options": [
        { "value": "heart", "label": "Heart" }, { "value": "shield", "label": "Shield" }, { "value": "box", "label": "Box" }, { "value": "smile", "label": "Smile" }
      ] },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Pet-First Shopping" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "A simple shopping experience centered on the animals that make home better." }
    ] }
  ],
  "presets": [{ "name": "P&C trust section", "blocks": [{"type":"trust"},{"type":"trust"},{"type":"trust"},{"type":"trust"}] }]
}
{% endschema %}
