<section class="newsletter" aria-label="Newsletter signup">
  <div class="container">
    <h2>{{ section.settings.heading | default: 'Join the Paws & Claws Family' }}</h2>
    <p>{{ section.settings.subheading | default: 'Get exclusive deals, new arrivals, and pet care tips delivered to your inbox.' }}</p>

    {% form 'customer', class: 'newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input
        class="newsletter__input"
        type="email"
        name="contact[email]"
        placeholder="{{ section.settings.placeholder | default: 'Your email address' }}"
        required
        aria-label="Email address">
      <button type="submit" class="btn btn-accent">
        {{ section.settings.button_label | default: 'Subscribe' }}
      </button>
    {% endform %}

    {%- if section.settings.disclaimer != blank -%}
      <p style="margin-top:0.75rem; font-size:0.8rem; opacity:0.55;">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Paws & Claws Family" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Get exclusive deals, new arrivals, and pet care tips delivered to your inbox." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer text", "default": "No spam. Unsubscribe anytime." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
