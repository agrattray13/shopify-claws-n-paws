<section class="hero section-padding" aria-label="Hero banner">
  {%- if section.settings.image -%}
    <div class="hero__bg">
      <img
        src="{{ section.settings.image | image_url: width: 1600 }}"
        alt="{{ section.settings.image.alt | default: shop.name }}"
        width="1600"
        height="700"
        loading="eager"
        fetchpriority="high">
    </div>
  {%- endif -%}

  <div class="container">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="hero__title">{{ section.settings.heading | default: 'Premium Pet Supplies for Every Tail Wag' }}</h1>

      {%- if section.settings.subheading != blank -%}
        <p class="hero__subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="hero__actions">
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: routes.collections_url | append: '/all' }}" class="btn btn-accent btn-lg">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_url | default: routes.collections_url | append: '/all' }}" class="btn btn-outline" style="color:#fff;border-color:rgba(255,255,255,0.7);">
            {{ section.settings.secondary_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Welcome to Paws & Claws" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Premium Pet Supplies for Every Tail Wag" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Discover curated, quality products for your dog or cat. Free shipping on qualifying orders." },
    { "type": "text", "id": "cta_label", "label": "Primary button label", "default": "Shop Now" },
    { "type": "url", "id": "cta_url", "label": "Primary button URL" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Learn More" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button URL" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
