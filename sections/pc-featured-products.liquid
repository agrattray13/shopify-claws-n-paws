{{ 'pc-product-cards.css' | asset_url | stylesheet_tag }}
{% assign featured_collection = section.settings.collection %}

<section class="pc-featured-products">
  <div class="pc-featured-products__top">
    <div class="pc-featured-products__heading">
      {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}<div>{{ section.settings.text }}</div>{% endif %}
    </div>
    {% if featured_collection != blank %}
      <a class="pc-products-link" href="{{ featured_collection.url }}">{{ section.settings.link_label | escape }} <span>→</span></a>
    {% endif %}
  </div>

  {% if featured_collection != blank and featured_collection.products_count > 0 %}
    <div class="pc-featured-products__grid">
      {% for product in featured_collection.products limit: section.settings.products_to_show %}
        {% render 'pc-product-card', product: product %}
      {% endfor %}
    </div>
  {% else %}
    <div class="pc-featured-products__empty">
      <strong>Choose a collection in the Theme Editor.</strong>
      <span>This section won’t create fake product links.</span>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .pc-featured-products { padding: 100px max(24px, calc((100vw - 1480px)/2)); background: #f6f7f3; color: #162238; }
  .pc-featured-products__top { margin-bottom: 40px; display: flex; align-items: end; justify-content: space-between; gap: 30px; }
  .pc-featured-products__heading { max-width: 740px; }
  .pc-featured-products__heading > p { margin: 0 0 12px; color: #7e9b81; font-size: 10px; font-weight: 850; letter-spacing: .15em; text-transform: uppercase; }
  .pc-featured-products__heading h2 { margin: 0; font-size: clamp(40px,5vw,68px); line-height: .98; letter-spacing: -.052em; }
  .pc-featured-products__heading > div { margin-top: 16px; color: #697481; font-size: 14px; line-height: 1.7; }
  .pc-featured-products__heading > div p { margin: 0; }
  .pc-products-link { margin-bottom: 4px; color: #162238; display: inline-flex; gap: 10px; align-items: center; text-decoration: none; font-size: 10px; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
  .pc-products-link span { transition: transform .2s ease; }
  .pc-products-link:hover span { transform: translateX(4px); }
  .pc-featured-products__grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 16px; }
  .pc-featured-products__empty { min-height: 250px; border: 1px dashed #cfd5cb; border-radius: 22px; display: grid; place-content: center; text-align: center; gap: 8px; color: #6f7983; }
  .pc-featured-products__empty strong { color: #162238; }
  @media (max-width: 989px) { .pc-featured-products__grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 749px) {
    .pc-featured-products { padding: 72px 18px; }
    .pc-featured-products__top { display: block; }
    .pc-products-link { margin-top: 22px; }
    .pc-featured-products__grid { gap: 9px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "P&C featured products",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pet parent approved" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Paws & Claws Favorites" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Useful, comfortable, fun, and easy-to-love picks for everyday pet life.</p>" },
    { "type": "text", "id": "link_label", "label": "Collection link label", "default": "Explore all" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "P&C featured products" }]
}
{% endschema %}
