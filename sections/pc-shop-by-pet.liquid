<section class="pc-pet-split">
  <div class="pc-section-heading pc-section-heading--center">
    {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2>{{ section.settings.heading | escape }}</h2>
    {% if section.settings.text != blank %}<div>{{ section.settings.text }}</div>{% endif %}
  </div>

  <div class="pc-pet-split__grid">
    {% for block in section.blocks %}
      {% assign pet_collection = block.settings.collection %}
      <article class="pc-pet-card" {{ block.shopify_attributes }}>
        <div class="pc-pet-card__media">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '520,760,1000,1400', sizes: '(min-width: 750px) 50vw, 100vw', alt: block.settings.heading }}
          {% elsif pet_collection != blank and pet_collection.featured_image != blank %}
            {{ pet_collection.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '520,760,1000,1400', sizes: '(min-width: 750px) 50vw, 100vw', alt: pet_collection.title }}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'pc-pet-card__placeholder' }}
          {% endif %}
        </div>
        <div class="pc-pet-card__shade"></div>
        <div class="pc-pet-card__content">
          {% if block.settings.kicker != blank %}<span>{{ block.settings.kicker | escape }}</span>{% endif %}
          <h3>{{ block.settings.heading | escape }}</h3>
          {% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}
          {% if pet_collection != blank %}
            <a href="{{ pet_collection.url }}">{{ block.settings.link_label | default: 'Shop collection' | escape }} <span aria-hidden="true">→</span></a>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .pc-pet-split { padding: 100px max(24px, calc((100vw - 1480px)/2)); background: #f7f3ea; color: #162238; }
  .pc-section-heading { max-width: 720px; margin-bottom: 42px; }
  .pc-section-heading--center { margin-inline: auto; text-align: center; }
  .pc-section-heading > p { margin: 0 0 13px; color: #7e9b81; font-size: 10px; font-weight: 850; letter-spacing: .15em; text-transform: uppercase; }
  .pc-section-heading h2 { margin: 0; font-size: clamp(38px, 5vw, 68px); line-height: .98; letter-spacing: -.052em; }
  .pc-section-heading > div { margin-top: 17px; color: #687383; font-size: 14px; line-height: 1.7; }
  .pc-section-heading > div p { margin: 0; }
  .pc-pet-split__grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px; }
  .pc-pet-card { position: relative; min-height: 590px; overflow: hidden; border-radius: 28px; background: #162238; color: #fff; }
  .pc-pet-card__media,
  .pc-pet-card__shade { position: absolute; inset: 0; }
  .pc-pet-card__media img,
  .pc-pet-card__placeholder { width: 100%; height: 100%; display: block; object-fit: cover; transition: transform .45s ease; }
  .pc-pet-card:hover .pc-pet-card__media img { transform: scale(1.035); }
  .pc-pet-card__shade { background: linear-gradient(0deg, rgba(14,24,38,.8), rgba(14,24,38,.08) 70%); }
  .pc-pet-card__content { position: absolute; z-index: 2; left: 0; right: 0; bottom: 0; padding: 40px; }
  .pc-pet-card__content > span { color: #d4a65a; font-size: 9px; font-weight: 850; letter-spacing: .15em; text-transform: uppercase; }
  .pc-pet-card h3 { margin: 8px 0 10px; font-size: clamp(38px,4vw,62px); line-height: 1; letter-spacing: -.05em; }
  .pc-pet-card p { max-width: 520px; margin: 0; color: rgba(255,255,255,.78); font-size: 13px; line-height: 1.6; }
  .pc-pet-card a { margin-top: 23px; display: inline-flex; align-items: center; gap: 12px; color: #fff; text-decoration: none; font-size: 10px; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
  .pc-pet-card a span { transition: transform .2s ease; }
  .pc-pet-card a:hover span { transform: translateX(5px); }
  @media (max-width: 749px) {
    .pc-pet-split { padding: 72px 18px; }
    .pc-pet-split__grid { grid-template-columns: 1fr; }
    .pc-pet-card { min-height: 470px; border-radius: 22px; }
    .pc-pet-card__content { padding: 28px 24px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "P&C shop by pet",
  "max_blocks": 2,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pick their side of the store" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Pet" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Two personalities. Two worlds of favorites. One place to spoil them both.</p>" }
  ],
  "blocks": [
    {
      "type": "pet",
      "name": "Pet card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Override image" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "For your best friend" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Dogs" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Play, walk, nap, repeat — discover everyday essentials made for life with dogs." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop dogs" }
      ]
    }
  ],
  "presets": [{ "name": "P&C shop by pet", "blocks": [{"type":"pet"},{"type":"pet"}] }]
}
{% endschema %}
